
name: Build NIREXION GLASS X APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'NirexionGlassX-edited.zip'
      - '.github/workflows/build-apk.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Extract project
        run: unzip -q NirexionGlassX-edited.zip

      - name: Build APK
        working-directory: NirexionGlassX
        run: gradle --no-daemon assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NIREXION-GLASS-X-debug-apk
          path: NirexionGlassX/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
